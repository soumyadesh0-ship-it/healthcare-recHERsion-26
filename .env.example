# Backend configuration template. All values below are deliberately fake.
# For a new checkout, copy to .env and configure locally; never overwrite an
# existing .env. Do not commit real credentials or embed server secrets in Flutter.

# Required at backend startup. Use a development project and its anon client key.
# Never substitute a service-role key: survey persistence relies on user RLS.
SUPABASE_URL=https://fake-auracare-project.invalid
SUPABASE_ANON_KEY=FAKE_SUPABASE_ANON_KEY_REPLACE_LOCALLY

# Required only for OpenAI chat calls. Keep this key server-side.
OPENAI_API_KEY=FAKE_OPENAI_API_KEY_REPLACE_LOCALLY
